rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connectivity Test
    match /test/connection {
      allow get: if true;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() { return request.auth != null; }
    
    // Auth tokens never contain custom claims in this environment.
    // We must look up roles using get() on a trusted database document.
    function getUserData(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path) ? get(path).data : {"role": "NONE"};
    }
    
    function isAdmin() { 
      let data = getUserData(request.auth.uid);
      return isSignedIn() && (
        data.role == 'ADMIN' || 
        data.role == 'admin' || 
        request.auth.token.email == 'master@system.local' ||
        (data.keys().hasAll(['isRoot']) && data.isRoot == true)
      ); 
    }

    function isCashier() {
      let data = getUserData(request.auth.uid);
      return isSignedIn() && (data.role == 'CASHIER' || data.role == 'employee');
    }

    function isManagerOrAdmin() {
      let data = getUserData(request.auth.uid);
      return isSignedIn() && (
        data.role in ['ADMIN', 'admin', 'BRANCH_MANAGER', 'ACCOUNTANT'] ||
        request.auth.token.email == 'master@system.local' ||
        (data.keys().hasAll(['isRoot']) && data.isRoot == true)
      );
    }

    function hasCashierManagement() {
      let data = getUserData(request.auth.uid);
      return isSignedIn() && (
        data.role in ['ADMIN', 'admin'] ||
        (
          data.role in ['BRANCH_MANAGER', 'ACCOUNTANT'] &&
          data.keys().hasAll(['permissions']) &&
          data.permissions.keys().hasAll(['cashierManagement']) &&
          data.permissions.cashierManagement == true
        ) ||
        request.auth.token.email == 'master@system.local' ||
        (data.keys().hasAll(['isRoot']) && data.isRoot == true)
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // --- DEFAULT DENY ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- ENTITY RULES ---
    // USERS
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid is string && 
               data.email is string && data.email.size() <= 200 &&
               data.role in ['ADMIN', 'CASHIER', 'admin', 'employee', 'BRANCH_MANAGER', 'ACCOUNTANT', 'SALES', 'PURCHASES', 'HR'] &&
               data.keys().hasAll(['uid', 'email', 'role']) &&
               data.keys().size() >= 3;
      }

      // All authenticated users can read users (managers/cashiers need to list users, select cashiers, etc.)
      allow read: if isSignedIn();
      
      // Only admins, the user themselves, or managers/accountants with cashierManagement permission can create.
      allow create: if isSignedIn() && (hasCashierManagement() || request.auth.uid == userId) && isValidId(userId) && isValidUser(incoming());
      
      // Only admins, the user themselves, or managers/accountants with cashierManagement permission can update.
      allow update: if isSignedIn() && (hasCashierManagement() || request.auth.uid == userId) && isValidId(userId) && 
                      incoming().uid == existing().uid &&
                      (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'role', 'branchId', 'allowedBranches', 'isActive', 'createdAt', 'permissions']) && 
                       (incoming().role == existing().role || isAdmin()));
      
      allow delete: if isAdmin();
    }

    // SHIFTS
    match /shifts/{shiftId} {
      function isValidShift(data) {
        let uData = getUserData(request.auth.uid);
        return (
          data.cashierId == request.auth.uid || 
          uData.role in ['ADMIN', 'admin', 'ACCOUNTANT'] ||
          (uData.role == 'BRANCH_MANAGER' && uData.branchId == data.branchId)
        ) &&
        data.branchId is string &&
        data.status in ['OPEN', 'CLOSED'];
      }
      
      allow read: if isSignedIn() && (
        resource.data.cashierId == request.auth.uid ||
        getUserData(request.auth.uid).role in ['ADMIN', 'admin', 'ACCOUNTANT'] ||
        (getUserData(request.auth.uid).role == 'BRANCH_MANAGER' && getUserData(request.auth.uid).branchId == resource.data.branchId)
      );
      allow create: if isSignedIn() && isValidShift(incoming());
      allow update: if isSignedIn() && (
        resource.data.cashierId == request.auth.uid ||
        getUserData(request.auth.uid).role in ['ADMIN', 'admin', 'ACCOUNTANT'] ||
        (getUserData(request.auth.uid).role == 'BRANCH_MANAGER' && getUserData(request.auth.uid).branchId == resource.data.branchId)
      );
      allow delete: if isAdmin();
    }

    // ORDERS
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.total is number && data.total >= 0 &&
               data.cashierId == request.auth.uid &&
               data.branchId is string &&
               data.shiftId is string &&
               data.items is list && data.items.size() > 0;
      }

      function isSameBranch() {
        let userData = getUserData(request.auth.uid);
        return isSignedIn() && userData.branchId == resource.data.branchId;
      }

      // Allow single-document read if it belongs to user or same branch
      allow get: if isSignedIn() && (resource.data.cashierId == request.auth.uid || isSameBranch() || isAdmin());
      // Allow listing for admin always; cashiers can list (client-side filtering handles branch scope)
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming());
      allow update: if isAdmin() || (
        isSignedIn() &&
        (request.auth.uid == resource.data.cashierId || 
         (resource.data.status == 'PENDING' && isSameBranch()))
      );
      allow delete: if isAdmin() || (
        isSignedIn() &&
        resource.data.status == 'PENDING' &&
        (request.auth.uid == resource.data.cashierId || isSameBranch())
      );
    }

    // PRODUCTS
    match /products/{productId} {
      function isValidProduct(data) {
        return data.name is string && data.name.size() <= 200 &&
               data.sellingPrice is number &&
               data.costPrice is number &&
               data.quantity is number;
      }

      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // WAREHOUSES
    match /warehouses/{warehouseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // CUSTOMERS
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // INVENTORY TRANSACTIONS
    match /inventory_transactions/{txId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && incoming().createdBy == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // CATEGORIES, BRANDS AND SHOE TYPES
    match /categories/{id} { allow read, write: if isSignedIn(); }
    match /brands/{id} { allow read, write: if isSignedIn(); }
    match /shoe_types/{id} { allow read, write: if isSignedIn(); }

    // ACCOUNTING COLLECTIONS (Simplified for testing)
    match /accounts/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /journal_entries/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /cost_centers/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /settings/main_store { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /system_settings/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /notifications/{id} { allow read, write: if isSignedIn(); }

    // --- SUPER ADMIN TENANTS COLLECTION ---
    // Only anonymous Firebase users (= Super Admin after login) can read/write.
    // Regular users authenticated via email/password are NOT anonymous.
    match /tenants/{tenantId} {
      function isSuperAdminSession() {
        // Super Admin signs in anonymously — regular users are never anonymous
        return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
      }
      allow read: if true;
      allow write: if isSuperAdminSession();
    }

    // --- SUPPLIERS ---
    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- PURCHASE RECEIPTS (فواتير التوريد) ---
    match /purchase_receipts/{receiptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- PURCHASE PAYMENTS (دفعات الموردين) ---
    match /purchase_payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- ADDITIONAL COLLECTIONS ---
    match /stock_levels/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /stock_takings/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /branches/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /transfers/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /accounts_payable/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /opening_balance/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }

    // --- ADDITIONAL APP COLLECTIONS (previously missing = default deny) ---
    match /currencies/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /check_stages/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /taxes/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /cash_transactions/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /reports/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // --- PRODUCT UNITS (وحدات القياس) ---
    match /product_units/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // --- ITEM MAPS (خريطة الأصناف) ---
    match /item_maps/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // --- ACCOUNTING JOURNALS (previously missing = default deny) ---
    match /journal/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /journalEntries/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /journal_vouchers/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }

    // --- PURCHASE RECEIPTS & PAYMENTS (full reset support) ---
    match /purchase_receipts/{id} { allow read: if isSignedIn(); allow create, update: if isSignedIn(); allow delete: if isAdmin(); }
    match /purchase_payments/{id} { allow read: if isSignedIn(); allow create, update: if isSignedIn(); allow delete: if isAdmin(); }
    match /suppliers/{id} { allow read: if isSignedIn(); allow create, update: if isSignedIn(); allow delete: if isAdmin(); }

    // --- TRANSFER RECEIPTS (استلام تحويل بضاعة) ---
    match /transfer_receipts/{id} { allow read: if isSignedIn(); allow create, update: if isSignedIn(); allow delete: if isAdmin(); }

    // --- ACTIVITY LOGS (سجل النشاط والتدقيق) ---
    match /activity_logs/{id} { allow read, create: if isSignedIn(); allow update, delete: if isAdmin(); }

    // --- POS DEVICES ---
    match /pos_devices/{id} {
      allow read: if isSignedIn();
      allow write: if isManagerOrAdmin();
    }

    // --- PRINT TEMPLATES ---
    match /print_templates/{id} {
      allow read: if isSignedIn();
      allow write: if isManagerOrAdmin();
    }

    // --- SECURITY LOGS ---
    match /security_logs/{id} {
      allow create: if isSignedIn();
      allow read: if isManagerOrAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
